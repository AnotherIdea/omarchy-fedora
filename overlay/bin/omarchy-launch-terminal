#!/bin/bash

# omarchy:summary=Launch a terminal in the active terminal's current directory
# omarchy:args=[--pid=<terminal-pid>] [command...]

pid=""
if [[ ${1:-} == --pid=* ]]; then
  pid=${1#--pid=}
  shift
fi

dir=$(omarchy-cmd-terminal-cwd "$pid")
if command -v xdg-terminal-exec >/dev/null 2>&1; then
  exec setsid uwsm-app -- xdg-terminal-exec --dir="$dir" "$@"
fi
# Fedora may not have xdg-terminal-exec. Ghostty is the terminal this fork uses.
exec setsid uwsm-app -- ghostty --working-directory="$dir" "$@"
